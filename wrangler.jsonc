{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lospor-user-guide",
  "compatibility_date": "2026-07-24",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "build"
  },
  "routes": [
    {
      "pattern": "guide.lospor.org",
      "custom_domain": true
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
